# Export these variables in your shell for bootRun. Spring does not load .env files.
DATABASE_URL=jdbc:postgresql://localhost:55432/wavelength
DATABASE_USERNAME=wavelength
DATABASE_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
# Supabase project URL: https://<project-ref>.supabase.co
JWT_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1
JWT_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
AUTH_AUTO_PROVISION=true
SPRING_PROFILES_ACTIVE=dev
DEV_SEED_ENABLED=false
DEV_SEED_AUTH_SUBJECT=dev|marc
CORS_ALLOWED_ORIGINS=http://localhost:8081
TRACING_ENABLED=false
# A 32-byte random AES key encoded as base64. Keep older keys after a rotation.
# Example format: v2:<base64>,v1:<previous-base64>
MUSIC_TOKEN_KEYS=
MUSIC_PUBLIC_BASE_URL=http://127.0.0.1:8080
MUSIC_WEB_RETURN_URI=http://localhost:8081/music/callback
MUSIC_NATIVE_RETURN_URI=wavelength://music/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/v1/music/spotify/callback
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_BASE64=
# Reserved for future adapters; no S3 uploads in this foundation.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
