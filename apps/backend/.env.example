# Export these variables in your shell for bootRun. Spring does not load .env files.
DATABASE_URL=jdbc:postgresql://localhost:55432/wavelength
DATABASE_USERNAME=wavelength
DATABASE_PASSWORD=wavelength_dev
REDIS_HOST=localhost
REDIS_PORT=6379
# Supabase project URL: https://<project-ref>.supabase.co
JWT_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1
JWT_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
JWT_AUDIENCE=authenticated
AUTH_AUTO_PROVISION=true
SPRING_PROFILES_ACTIVE=dev
DEV_SEED_ENABLED=false
DEV_SEED_AUTH_SUBJECT=dev|marc
CORS_ALLOWED_ORIGINS=http://localhost:8081
TRACING_ENABLED=false
# Reserved for future adapters; no real OAuth or S3 uploads in this foundation.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
